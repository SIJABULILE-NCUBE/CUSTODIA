# i copy this file to .env and fill in my real values, i never commit the real .env file

# these come from my supabase project settings, under API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# the port i want my express server to run on locally
PORT=4000

# the url of my frontend, so cors knows who is allowed to call this api
FRONTEND_URL=http://localhost:5173
